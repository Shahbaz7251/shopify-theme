{%- liquid
  assign found = false
  if recommendations.performed? and recommendations.products_count > 0
    assign found = true
  endif
  assign tile_sizes = '(min-width: 1100px) 23vw, (min-width: 721px) 30vw, 62vw'
-%}
<script src="{{ 'product.js' | asset_url }}" defer></script>
<section
  id="section-{{ section.id }}"
  class="chapter product-recs"
  data-section="product-recommendations"
  data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.limit }}"
  style="--c:var(--paper);--i:var(--ink)"
  {% unless found %}
    hidden
  {% endunless %}
>
  <div data-recs-inner>
    {%- if found -%}
      <div class="wrap">
        <h2 class="product-recs__heading">{{ section.settings.heading | escape }}</h2>
      </div>
      <ul class="product-recs__row" data-recs-row tabindex="0" aria-label="{{ section.settings.heading | escape }}">
        {%- for rec in recommendations.products -%}
          <li class="product-recs__item">
            {% render 'product-tile', product: rec, sizes: tile_sizes %}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>


{% schema %}
{
  "name": "You may also like",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 6 }
  ],
  "presets": [
    { "name": "You may also like" }
  ]
}
{% endschema %}
