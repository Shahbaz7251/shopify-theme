{%- if section.settings.text != blank -%}
  <div class="announce" style="--c:var(--{{ section.settings.colour }});--i:var(--{{ section.settings.colour }}-ink)">
    <div class="wrap announce__in">
      {%- if section.settings.link != blank -%}
        <a href="{{ section.settings.link }}">{{ section.settings.text | escape }}</a>
      {%- else -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}


{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free shipping on orders over $35" },
    { "type": "url", "id": "link", "label": "Link" },
    {
      "type": "select",
      "id": "colour",
      "label": "Colour",
      "options": [
        { "value": "action", "label": "Button red" },
        { "value": "block-b", "label": "Dark block" },
        { "value": "ink", "label": "Text colour" },
        { "value": "hero", "label": "Hero" }
      ],
      "default": "block-b"
    }
  ]
}
{% endschema %}
