{%- assign token = section.settings.color -%}
<section
  id="section-{{ section.id }}"
  class="chapter review-stack"
  data-section="review-stack"
  style="--c:var(--{{ token }});--i:var(--{{ token }}-ink)"
>
  <div class="wrap review-stack__in">
    <div class="review-stack__side">
      {%- if section.settings.score != blank -%}
        <p class="review-stack__score">
          <span class="sr-only">{{ section.settings.score | escape }}</span>
          <span aria-hidden="true" data-score="{{ section.settings.score | escape }}">{{ section.settings.score | escape }}</span>
        </p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="review-stack__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.text != blank -%}
        <p>{{ section.settings.text | escape }}</p>
      {%- endif -%}
      {%- if section.settings.next_label != blank and section.blocks.size > 1 -%}
        <button type="button" class="btn btn--dark btn--plain review-stack__next" data-next>
          {{- section.settings.next_label | escape -}}
        </button>
      {%- endif -%}
      {%- if section.settings.small_note != blank -%}
        <p class="small">{{ section.settings.small_note | escape }}</p>
      {%- endif -%}
    </div>
    <div class="review-stack__stack" data-stack>
      {%- for block in section.blocks -%}
        {%- liquid
          assign k = forloop.index0 | at_most: 2
          assign tilt = '0deg'
          if k == 1
            assign tilt = '2.2deg'
          elsif k == 2
            assign tilt = '-2.2deg'
          endif
          assign card_token = block.settings.color
        -%}
        <article
          class="review-stack__card"
          style="--c:var(--{{ card_token }});--i:var(--{{ card_token }}-ink);--k:{{ k }};--r:{{ tilt }};z-index:{{ forloop.rindex }}{% if forloop.index0 > 2 %};opacity:0{% endif %}"
          {{ block.shopify_attributes }}
        >
          <q class="review-stack__quote">{{ block.settings.quote | escape }}</q>
          <div class="review-stack__who">
            <span class="review-stack__pet">
              {%- render 'cutout',
                image: block.settings.image,
                stand_in: block.settings.stand_in,
                sizes: '52px',
                width: 240
              -%}
            </span>
            <span>
              {{- block.settings.author | escape -}}
              {%- if block.settings.product_name != blank -%}
                , {{ block.settings.product_name | escape }}
              {%- endif -%}
            </span>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>


{% schema %}
{
  "name": "Flick stack",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "score", "label": "Review score", "default": "4.9" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Reviews from our customers" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Flick a card away to read the next one." },
    { "type": "text", "id": "next_label", "label": "Next button label", "default": "Next review" },
    { "type": "text", "id": "small_note", "label": "Small note" },
    {
      "type": "select",
      "id": "color",
      "label": "Colour",
      "options": [
        { "value": "hero", "label": "Hero" },
        { "value": "paper", "label": "Page" },
        { "value": "ink", "label": "Text colour" },
        { "value": "block-a", "label": "Light block" },
        { "value": "block-b", "label": "Dark block" },
        { "value": "action", "label": "Button colour" },
        { "value": "pop", "label": "Accent" },
        { "value": "rain", "label": "Chip rain" },
        { "value": "chicken", "label": "Chicken" },
        { "value": "turkey", "label": "Turkey" },
        { "value": "beef", "label": "Beef" },
        { "value": "fish", "label": "Fish" }
      ],
      "default": "block-a"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Sample review. My dog sits before I open the bag." },
        { "type": "text", "id": "author", "label": "Name", "default": "Sample customer" },
        { "type": "text", "id": "product_name", "label": "Product", "default": "Chicken chips" },
        { "type": "image_picker", "id": "image", "label": "Pet photo" },
        {
          "type": "select",
          "id": "stand_in",
          "label": "Drawn pet until a photo is added",
          "options": [
            { "value": "golden", "label": "Golden dog" },
            { "value": "dachs", "label": "Dachshund" },
            { "value": "cat", "label": "Cat" }
          ],
          "default": "golden"
        },
        {
          "type": "select",
          "id": "color",
          "label": "Card colour",
          "options": [
            { "value": "hero", "label": "Hero" },
            { "value": "paper", "label": "Page" },
            { "value": "ink", "label": "Text colour" },
            { "value": "block-a", "label": "Light block" },
            { "value": "block-b", "label": "Dark block" },
            { "value": "action", "label": "Button colour" },
            { "value": "pop", "label": "Accent" },
            { "value": "rain", "label": "Chip rain" },
            { "value": "chicken", "label": "Chicken" },
            { "value": "turkey", "label": "Turkey" },
            { "value": "beef", "label": "Beef" },
            { "value": "fish", "label": "Fish" }
          ],
          "default": "paper"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flick stack",
      "blocks": [
        { "type": "review" },
        { "type": "review" },
        { "type": "review" }
      ]
    }
  ]
}
{% endschema %}
