<style>
  .announce { background: var(--accent); color: var(--accent-ink); font-size: var(--s-small); text-align: center; padding: 9px var(--m); }
  .announce p { margin: 0; }
  .announce a { text-decoration: underline; text-underline-offset: 3px; }
</style>
{%- if section.settings.text != blank -%}
  <div class="announce" {{ section.shopify_attributes }}>
    {%- if section.settings.link != blank -%}
      <a href="{{ section.settings.link }}">{{ section.settings.text }}</a>
    {%- else -%}
      <p>{{ section.settings.text }}</p>
    {%- endif -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "settings": [
    { "type": "text", "id": "text", "label": "Text", "default": "Free delivery across India over ₹999 · Cash on delivery" },
    { "type": "url", "id": "link", "label": "Link" }
  ]
}
{% endschema %}
