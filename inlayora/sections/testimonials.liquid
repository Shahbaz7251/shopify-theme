{%- liquid
  assign app_blocks = section.blocks | where: 'type', '@app'
  assign quotes = section.blocks | where: 'type', 'quote'
-%}
<div class="frame section" id="reviews">
  <div class="sec-head rv">
    <div>
      <h2 class="h-sec">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="body">{{ section.settings.text }}</p>{%- endif -%}
    </div>
  </div>

  {%- if app_blocks.size > 0 -%}
    {%- for block in app_blocks -%}<div class="app-slot">{% render block %}</div>{%- endfor -%}
  {%- endif -%}

  {%- if quotes.size > 0 and section.settings.show_quotes -%}
    <div class="quotes">
      {%- for block in quotes -%}
        {%- assign tone = forloop.index0 | modulo: 3 -%}
        <figure class="quote {% case tone %}{% when 0 %}f3{% when 1 %}f2{% else %}f1{% endcase %} rv" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
          <span class="stars" aria-label="{{ 'general.stars' | t: count: block.settings.rating }}">{%- for i in (1..block.settings.rating) -%}{% render 'icon', name: 'star' %}{%- endfor -%}</span>
          <blockquote>{{ block.settings.quote }}</blockquote>
          <figcaption>
            {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 96, height: 96, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
            <span><b>{{ block.settings.name }}</b>{{ block.settings.detail }}</span>
          </figcaption>
        </figure>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .quotes { display: grid; gap: 10px; }
  @media (min-width: 900px) { .quotes { grid-template-columns: repeat(3, 1fr); gap: 12px; } }
  .quote { margin: 0; border-radius: var(--r); padding: 24px; display: flex; flex-direction: column; gap: 14px; }
  .quote blockquote { margin: 0; }
  .quote figcaption { display: flex; align-items: center; gap: 12px; margin-top: auto; font-size: var(--s-small); color: var(--muted); }
  .quote figcaption img { width: 48px; height: 48px; border-radius: 10px; object-fit: cover; }
  .quote figcaption b { display: block; font-weight: 500; font-size: 1rem; color: var(--ink); }
{% endstylesheet %}

{% schema %}
{
  "name": "Reviews",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "What buyers say" },
    { "type": "text", "id": "text", "label": "Text" },
    { "type": "checkbox", "id": "show_quotes", "label": "Show quote cards", "info": "Turn off once a reviews app block is added. Only use real customer reviews.", "default": true }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "Looks even better in person. The border feels solid and the glossy top wipes clean." },
        { "type": "text", "id": "name", "label": "Name", "default": "Customer name" },
        { "type": "text", "id": "detail", "label": "Detail", "default": "City · product" },
        { "type": "range", "id": "rating", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "image_picker", "id": "image", "label": "Customer photo" }
      ]
    }
  ],
  "presets": [
    { "name": "Reviews", "blocks": [{ "type": "quote" }, { "type": "quote" }, { "type": "quote" }] }
  ]
}
{% endschema %}
