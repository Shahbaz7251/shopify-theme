{%- liquid
  assign size_option = nil
  for option in product.options_with_values
    assign opt_name = option.name | downcase
    if opt_name contains 'size'
      assign size_option = option
      break
    endif
  endfor
  assign img = section.settings.image | default: product.featured_media.preview_image
-%}
{%- if size_option -%}
  <div class="frame fitwrap">
    <details class="fitx f2" id="fit" data-fit-section data-surface-cm="{{ section.settings.surface_cm }}" {% if section.settings.open %}open{% endif %}>
      <summary class="fitx__sum">
        <span><b class="h-sub">{{ section.settings.heading }}</b><span class="small">{{ section.settings.summary }}</span></span>
        <span class="pm" aria-hidden="true"></span>
      </summary>
      <div class="fitx__body">
        <div class="fitx__stage" aria-hidden="true">
          <div class="fitx__surface">
            <div class="fitx__tray" data-fit-tray>
              {%- if img -%}{{ img | image_url: width: 700, height: 700, crop: 'center' | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
            </div>
            <span class="fitx__label">{{ section.settings.surface_label }}</span>
          </div>
          <span class="fitx__mug"></span>
        </div>
        <div class="fitx__read">
          {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
          <strong data-fit-cm aria-live="polite"></strong>
          <p data-fit-note></p>
          {%- if product.options.size == 1 -%}
            <div class="fitx__sizes" role="radiogroup" aria-label="{{ size_option.name }}">
              {%- for value in size_option.values -%}
                {%- assign short = value | split: '(' | last | remove: ')' | strip -%}
                <button type="button" role="radio" class="pill" data-pick-value="{{ value | escape }}" aria-checked="{% if size_option.selected_value == value %}true{% else %}false{% endif %}">
                  <b>{{ short }}</b>
                  {%- for v in product.variants -%}{%- if v.option1 == value -%}<small>{{ v.price | money }}</small>{%- endif -%}{%- endfor -%}
                </button>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </details>
  </div>
{%- endif -%}

{% stylesheet %}
  .fitwrap { padding-top: 12px; }
  .fitx { border-radius: var(--r); }
  .fitx__sum { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 64px; padding: 16px 20px; cursor: pointer; }
  .fitx__sum::-webkit-details-marker { display: none; }
  .fitx__sum > span:first-child { display: grid; gap: 2px; }
  .fitx__sum .h-sub { font-weight: 500; }
  .fitx[open] .pm::after { transform: rotate(0); }
  .fitx__body { display: grid; gap: 20px; padding: 0 20px 20px; }
  @media (min-width: 900px) { .fitx__body { grid-template-columns: 1.1fr 1fr; align-items: center; gap: 40px; padding: 4px 32px 32px; } }
  .fitx__stage { position: relative; aspect-ratio: 4 / 3; border-radius: var(--r); background: #e9e1d4; display: grid; place-items: center; overflow: hidden; }
  .fitx__surface { position: relative; width: 78%; aspect-ratio: 1; border-radius: 22%; background: #d8cbb6; box-shadow: inset 0 0 0 10px #cdbea6; display: grid; place-items: center; }
  .fitx__label { position: absolute; bottom: 10px; font-size: 0.75rem; color: #6b5b43; }
  .fitx__tray { width: var(--w, 66%); aspect-ratio: 1; border-radius: 50%; overflow: hidden; box-shadow: 0 0 0 6px #a26f3d inset, 0 16px 30px -12px rgba(0, 0, 0, 0.4); transition: width 600ms var(--ease-out); }
  .fitx__tray img { width: 100%; height: 100%; object-fit: cover; transform: scale(1.15); }
  .fitx__mug { position: absolute; right: 11%; top: 14%; width: 9%; aspect-ratio: 1; border-radius: 50%; background: #fbfbfa; box-shadow: 0 0 0 3px #1c1c1c inset, 0 6px 12px -6px rgba(0, 0, 0, 0.4); }
  .fitx__mug::after { content: ""; position: absolute; right: -28%; top: 38%; width: 30%; height: 24%; border: 3px solid #1c1c1c; border-left: 0; border-radius: 0 8px 8px 0; }
  .fitx__read { display: grid; gap: 10px; }
  .fitx__read p { margin: 0; color: var(--muted); }
  .fitx__read strong { font-size: clamp(2rem, 1.6rem + 1.6vw, 2.8rem); font-weight: 500; letter-spacing: -0.03em; line-height: 1; font-variant-numeric: tabular-nums; }
  .fitx__sizes { display: grid; grid-template-columns: repeat(auto-fit, minmax(84px, 1fr)); gap: 8px; margin-top: 6px; }
  .fitx__sizes .pill[aria-checked="true"] { background: var(--paper); outline: 2px solid var(--accent); outline-offset: -2px; }
  .fitx__sizes .pill:active { transform: scale(0.97); }
{% endstylesheet %}

{% schema %}
{
  "name": "Will it fit",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Will it fit?" },
    { "type": "text", "id": "summary", "label": "Summary line", "default": "See each size to scale on an ottoman" },
    { "type": "checkbox", "id": "open", "label": "Open by default", "default": false },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Drawn to scale on a typical 60 cm ottoman, with a mug for reference." },
    { "type": "image_picker", "id": "image", "label": "Top-down image", "info": "Defaults to the product's first image." },
    { "type": "text", "id": "surface_label", "label": "Surface label", "default": "Ottoman, about 60 cm" },
    { "type": "range", "id": "surface_cm", "label": "Surface width", "min": 40, "max": 120, "step": 5, "unit": "cm", "default": 60 }
  ],
  "presets": [{ "name": "Will it fit" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
