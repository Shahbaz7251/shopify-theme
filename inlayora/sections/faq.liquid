<div class="frame section">
  <div class="faq">
    <div class="rv">
      <h2 class="h-sec">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="body">{{ section.settings.text }}</p>{%- endif -%}
      {%- if settings.whatsapp_number != blank and section.settings.show_whatsapp -%}
        <a class="btn btn--paper faq__wa" href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">{% render 'icon', name: 'whatsapp' %}{{ 'header.whatsapp' | t }}</a>
      {%- endif -%}
    </div>
    <div class="acc">
      {%- for block in section.blocks -%}
        <details class="q" name="faq-{{ section.id }}" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
          <summary>{{ block.settings.question }}<span class="pm" aria-hidden="true"></span></summary>
          <div class="q__a rte">{{ block.settings.answer }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</div>

{%- if section.settings.schema_markup and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          { "@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} } }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% stylesheet %}
  .faq { display: grid; gap: 28px; }
  @media (min-width: 900px) { .faq { grid-template-columns: 4fr 8fr; gap: 48px; } }
  .faq__wa { margin-top: 20px; }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before you order" },
    { "type": "text", "id": "text", "label": "Text", "default": "Still unsure? WhatsApp us and we reply the same day." },
    { "type": "checkbox", "id": "show_whatsapp", "label": "Show WhatsApp button", "default": true },
    { "type": "checkbox", "id": "open_first", "label": "Open first question", "default": true },
    { "type": "checkbox", "id": "schema_markup", "label": "Add FAQ structured data for Google", "default": true }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How long does delivery take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We dispatch in 2–3 working days and most orders arrive within 5–7 days across India, with tracking by SMS and email.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "FAQ", "blocks": [{ "type": "question" }] }
  ]
}
{% endschema %}
