<div class="frame section">
  {%- if section.settings.heading != blank -%}
    <div class="sec-head rv"><h2 class="h-sec">{{ section.settings.heading }}</h2></div>
  {%- endif -%}
  <div class="pair">
    {%- for block in section.blocks -%}
      <article class="panel {{ block.settings.tone }} rv" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <a class="panel__pic" href="{{ block.settings.link }}" tabindex="-1" aria-hidden="true">
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 1400 | image_tag: widths: '500, 750, 1000, 1400', sizes: '(min-width: 900px) 50vw, 100vw', loading: 'lazy', alt: '' }}
          {%- else -%}
            {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </a>
        <div class="panel__row">
          <div>
            <h3 class="h-sub">{{ block.settings.title }}</h3>
            {%- if block.settings.text != blank -%}<p>{{ block.settings.text }}</p>{%- endif -%}
          </div>
          <div class="panel__acts">
            {%- if block.settings.button_1_label != blank -%}<a class="btn btn--ink" href="{{ block.settings.link }}">{{ block.settings.button_1_label }}</a>{%- endif -%}
            {%- if block.settings.button_2_label != blank -%}<a class="btn btn--paper" href="{{ block.settings.button_2_link | default: block.settings.link }}">{{ block.settings.button_2_label }}</a>{%- endif -%}
          </div>
        </div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .pair { display: grid; gap: 10px; }
  @media (min-width: 900px) { .pair { grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); } }
  .panel { position: relative; border-radius: var(--r); overflow: hidden; display: flex; flex-direction: column; min-height: 460px; }
  .panel__pic { flex: 1; position: relative; overflow: hidden; min-height: 320px; }
  .panel__pic img, .panel__pic svg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .panel:hover .panel__pic img { transform: scale(1.03); } }
  .panel__row { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; padding: 22px 24px 24px; }
  .panel__row p { margin: 6px 0 0; }
  .panel__acts { display: flex; gap: 8px; }
  @media (min-width: 900px) { .panel { min-height: min(680px, 78svh); } }
  @media (max-width: 599px) { .panel__acts { width: 100%; } .panel__acts .btn { flex: 1; padding: 0 12px; } }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by piece",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop by piece" }
  ],
  "blocks": [
    {
      "type": "panel",
      "name": "Panel",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "title", "label": "Title", "default": "Serving trays" },
        { "type": "text", "id": "text", "label": "Text", "default": "104 designs · 3 sizes · from ₹849" },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop trays" },
        { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Size guide" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
        { "type": "select", "id": "tone", "label": "Tile colour", "options": [{ "value": "f3", "label": "Blush" }, { "value": "f2", "label": "Sage" }, { "value": "f1", "label": "Slate" }, { "value": "f0", "label": "Stone" }], "default": "f3" }
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    { "name": "Shop by piece", "blocks": [{ "type": "panel" }, { "type": "panel", "settings": { "title": "Side tables", "text": "380+ designs · ₹2,399", "button_1_label": "Shop tables", "button_2_label": "Details", "tone": "f2" } }] }
  ]
}
{% endschema %}
