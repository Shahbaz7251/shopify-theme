{%- liquid
  assign img = section.settings.image
  assign img_mobile = section.settings.image_mobile | default: img
  assign heading_tag = 'h2'
  if section.index == 1 and section.location == 'template'
    assign heading_tag = 'h1'
  endif
  assign loading = 'lazy'
  if section.index <= 2
    assign loading = 'eager'
  endif
-%}
<section class="banner banner--{{ section.settings.height }}{% if section.settings.overlay == false %} banner--clean{% endif %}" style="--focus-x: {{ section.settings.mobile_focus }}%" aria-labelledby="Banner-{{ section.id }}">
  {%- if img -%}
    <picture>
      {%- if section.settings.image_mobile -%}
        <source media="(max-width: 767px)" srcset="{{ img_mobile | image_url: width: 750 }} 750w, {{ img_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
      {%- endif -%}
      {%- if loading == 'eager' -%}
        {{ img | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '(min-width: 1400px) 1380px, (min-width: 768px) 100vw, 250vw', fetchpriority: 'high', loading: 'eager', class: 'banner__img' }}
      {%- else -%}
        {{ img | image_url: width: 2400 | image_tag: widths: '750, 1100, 1500, 1800, 2400', sizes: '(min-width: 1400px) 1380px, (min-width: 768px) 100vw, 250vw', loading: 'lazy', class: 'banner__img' }}
      {%- endif -%}
    </picture>
  {%- else -%}
    {{ 'lifestyle-1' | placeholder_svg_tag: 'banner__img placeholder-svg' }}
  {%- endif -%}
  <div class="banner__body">
    {%- if section.settings.heading != blank -%}
      <{{ heading_tag }} class="h-hero" id="Banner-{{ section.id }}">{{ section.settings.heading }}</{{ heading_tag }}>
    {%- endif -%}
    {%- if section.settings.text != blank -%}<p class="lead">{{ section.settings.text }}</p>{%- endif -%}
    {%- if section.settings.button_1_label != blank or section.settings.button_2_label != blank -%}
      <div class="banner__ctas">
        {%- if section.settings.button_1_label != blank -%}<a class="btn btn--paper" href="{{ section.settings.button_1_link | default: routes.all_products_collection_url }}">{{ section.settings.button_1_label }}</a>{%- endif -%}
        {%- if section.settings.button_2_label != blank -%}<a class="btn btn--ghost" href="{{ section.settings.button_2_link | default: routes.all_products_collection_url }}">{{ section.settings.button_2_label }}</a>{%- endif -%}
      </div>
    {%- endif -%}
    {%- if section.settings.show_trust -%}
      <ul class="banner__facts">
        {%- if settings.free_shipping_threshold > 0 -%}<li>{% render 'icon', name: 'check' %}{{ 'general.free_delivery_over' | t: amount: settings.free_shipping_threshold }}</li>{%- endif -%}
        {%- if settings.cod_available -%}<li>{% render 'icon', name: 'check' %}{{ 'general.cod' | t }}</li>{%- endif -%}
        <li>{% render 'icon', name: 'check' %}{{ 'general.easy_returns' | t: days: settings.return_days }}</li>
      </ul>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .banner { position: relative; margin: 0 var(--m); border-radius: calc(var(--r) + 6px); overflow: hidden; display: flex; align-items: flex-end; color: #fff; }
  .banner--tall { min-height: min(76svh, 700px); }
  .banner--medium { min-height: min(58svh, 520px); }
  .banner--short { min-height: 340px; }
  .banner__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 767px) { .banner__img { object-position: var(--focus-x, 50%) 50%; } }
  .banner::after { content: ""; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(20, 18, 14, 0.05) 0%, rgba(20, 18, 14, 0.5) 40%, rgba(20, 18, 14, 0.82) 100%); }
  .banner--clean::after { display: none; }
  .banner--clean { color: var(--ink); }
  .banner__body { position: relative; z-index: 1; padding: 28px 22px; max-width: 640px; }
  .banner .lead { color: inherit; opacity: 0.92; }
  .banner__ctas { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 26px; }
  .btn--ghost { color: #fff; outline: 1.5px solid rgba(255, 255, 255, 0.8); outline-offset: -1.5px; }
  @media (hover: hover) and (pointer: fine) { .btn--ghost:hover { background: #fff; color: var(--ink); } }
  .banner__facts { list-style: none; margin: 20px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px 18px; font-size: var(--s-small); opacity: 0.9; }
  .banner__facts li { display: flex; align-items: center; gap: 6px; }
  .banner__facts .icon { width: 16px; height: 16px; }
  @media (min-width: 768px) {
    .banner { margin: 0 auto; width: calc(100% - 2 * var(--m)); max-width: calc(var(--max) - 2 * var(--m)); align-items: center; }
    .banner::after { background: linear-gradient(90deg, rgba(20, 18, 14, 0.66) 0%, rgba(20, 18, 14, 0.3) 45%, rgba(20, 18, 14, 0) 72%); }
    .banner__body { padding: 56px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Image banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "image_picker", "id": "image_mobile", "label": "Mobile image", "info": "Optional portrait crop for phones." },
    { "type": "range", "id": "mobile_focus", "label": "Mobile crop position", "info": "Moves the phone crop left or right when no mobile image is set.", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 50 },
    { "type": "select", "id": "height", "label": "Height", "options": [{ "value": "tall", "label": "Tall" }, { "value": "medium", "label": "Medium" }, { "value": "short", "label": "Short" }], "default": "tall" },
    { "type": "checkbox", "id": "overlay", "label": "Darken image behind text", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Handmade trays & tables" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Solid mango wood, finished by artisans in India. Trays from ₹849, side tables ₹2,399." },
    { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop serving trays" },
    { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
    { "type": "text", "id": "button_2_label", "label": "Button 2 label", "default": "Shop side tables" },
    { "type": "url", "id": "button_2_link", "label": "Button 2 link" },
    { "type": "checkbox", "id": "show_trust", "label": "Show delivery, COD and returns", "default": true }
  ],
  "presets": [{ "name": "Image banner" }]
}
{% endschema %}
