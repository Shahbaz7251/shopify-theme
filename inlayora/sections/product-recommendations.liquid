{%- liquid
  assign intent = section.settings.intent
  assign limit = section.settings.limit
-%}
<div class="frame section">
  <product-recommendations data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ limit }}&intent={{ intent }}">
    {%- if recommendations.performed? and recommendations.products_count > 0 -%}
      <div class="sec-head rv">
        <h2 class="h-sec">{{ section.settings.heading }}</h2>
      </div>
      <div class="spec-grid">
        {%- for rec in recommendations.products -%}
          {% render 'product-card', product: rec, index: forloop.index0 %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </product-recommendations>
</div>

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    {
      "type": "select",
      "id": "intent",
      "label": "Type",
      "options": [
        { "value": "related", "label": "Related (similar products)" },
        { "value": "complementary", "label": "Complementary (set in Search & Discovery app)" }
      ],
      "default": "related"
    },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 2, "default": 4 }
  ],
  "presets": [{ "name": "Product recommendations" }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
