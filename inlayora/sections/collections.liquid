<div class="frame coll">
  <h1 class="h-sec coll__head">{{ 'collections.title' | t }}</h1>
  <div class="colls">
    {%- for item in collections -%}
      {%- if item.products_count > 0 and item.handle != 'frontpage' -%}
        {%- assign tone = forloop.index0 | modulo: 3 | plus: 1 -%}
        <a class="colls__item f{{ tone }} rv" style="--i: {{ forloop.index0 | modulo: 4 }}" href="{{ item.url }}">
          <div class="colls__pic">
            {%- assign img = item.featured_image | default: item.products.first.featured_media.preview_image -%}
            {%- if img -%}{{ img | image_url: width: 800, height: 800, crop: 'center' | image_tag: widths: '300, 500, 800', sizes: '(min-width: 900px) 33vw, 50vw', loading: 'lazy', alt: '' }}{%- endif -%}
          </div>
          <div class="colls__row"><b>{{ item.title }}</b><span class="small">{{ 'collections.product_count' | t: count: item.products_count }}</span></div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .colls { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; }
  @media (min-width: 900px) { .colls { grid-template-columns: repeat(3, 1fr); gap: 12px; } }
  .colls__item { border-radius: var(--r); overflow: hidden; display: block; }
  .colls__pic { aspect-ratio: 1; overflow: hidden; }
  .colls__pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .colls__item:hover img { transform: scale(1.04); } }
  .colls__row { padding: 14px 16px 16px; display: grid; gap: 2px; }
  .colls__row b { font-weight: 500; }
{% endstylesheet %}

{% schema %}
{
  "name": "Collections list",
  "settings": []
}
{% endschema %}
