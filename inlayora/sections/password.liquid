<div class="frame pw">
  <div class="pw__box f2">
    <span class="mark">{{ shop.name | downcase }}</span>
    <h1 class="h-sec">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}<p class="lead">{{ shop.password_message }}</p>{%- endif -%}
    {%- form 'storefront_password', class: 'pw__form' -%}
      {%- if form.errors -%}<div class="form-error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
      <label class="visually-hidden" for="PasswordInput">{{ 'password.password' | t }}</label>
      <input class="field" id="PasswordInput" type="password" name="password" autocomplete="current-password" placeholder="{{ 'password.password' | t }}">
      <button class="btn btn--accent" type="submit">{{ 'password.enter' | t }}</button>
    {%- endform -%}
  </div>
</div>

{% stylesheet %}
  .pw { min-height: 100svh; display: grid; place-items: center; padding-top: 24px; padding-bottom: 24px; }
  .pw__box { border-radius: calc(var(--r) + 6px); padding: 40px 24px; width: 100%; max-width: 620px; display: grid; gap: 16px; }
  .pw__form { display: flex; gap: 8px; flex-wrap: wrap; }
  .pw__form .field { flex: 1; min-width: 200px; border-radius: 999px; }
  .pw__form [role="alert"] { width: 100%; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}
