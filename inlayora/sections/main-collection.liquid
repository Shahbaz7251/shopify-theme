<div class="frame coll">
  <header class="coll__head">
    <h1 class="h-sec">{{ collection.title }}</h1>
    {%- if collection.description != blank and section.settings.show_description -%}
      <div class="body rte">{{ collection.description }}</div>
    {%- endif -%}
  </header>

  {%- paginate collection.products by section.settings.per_page -%}
    {% render 'facets', results: collection %}

    {%- if collection.products.size > 0 -%}
      {%- liquid
        assign exclude = section.settings.exclude_collection
        assign exclude_handle = ''
        if exclude and exclude.handle != collection.handle and current_page == 1
          assign exclude_handle = exclude.handle
        endif
        assign shown = 0
      -%}
      <div class="spec-grid">
        {%- for product in collection.products -%}
          {%- if exclude_handle != blank -%}
            {%- assign handles = product.collections | map: 'handle' -%}
            {%- if handles contains exclude_handle -%}{%- continue -%}{%- endif -%}
          {%- endif -%}
          {%- if shown < 4 -%}
            {% render 'product-card', product: product, index: shown, eager: true %}
          {%- else -%}
            {% render 'product-card', product: product, index: shown %}
          {%- endif -%}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="coll__empty f0">
        <p>{{ 'collections.empty' | t }}</p>
        <a class="btn btn--accent" href="{{ collection.url }}">{{ 'collections.clear_all' | t }}</a>
      </div>
    {%- endif -%}

    {%- if paginate.pages > 1 -%}
      <nav class="pagination" aria-label="{{ 'general.pagination' | t }}">
        {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}" aria-label="{{ 'general.previous' | t }}">{% render 'icon', name: 'arrow-left' %}</a>{%- endif -%}
        {%- for part in paginate.parts -%}
          {%- if part.is_link -%}<a href="{{ part.url }}">{{ part.title }}</a>{%- elsif part.title == paginate.current_page -%}<span class="current" aria-current="page">{{ part.title }}</span>{%- else -%}<span>{{ part.title }}</span>{%- endif -%}
        {%- endfor -%}
        {%- if paginate.next -%}<a href="{{ paginate.next.url }}" aria-label="{{ 'general.next' | t }}">{% render 'icon', name: 'arrow' %}</a>{%- endif -%}
      </nav>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Collection",
  "settings": [
    { "type": "range", "id": "per_page", "label": "Products per page", "min": 8, "max": 48, "step": 4, "default": 24 },
    { "type": "checkbox", "id": "show_description", "label": "Show collection description", "default": true },
    { "type": "collection", "id": "exclude_collection", "label": "Hide products shown in highlight", "info": "Use the same collection as the Collection highlight section, so those products are not repeated below." }
  ]
}
{% endschema %}
