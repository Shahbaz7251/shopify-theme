<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    <meta name="theme-color" content="{{ settings.color_background }}">
    {%- if settings.favicon -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64, height: 64 }}">
    {%- endif -%}
    {{ 'chillax-500.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {% render 'css-variables' %}
    <style>{% render 'base-styles' %}</style>
    <script>
      document.documentElement.classList.replace('no-js', 'js');
      {%- if settings.animations and request.design_mode == false %}
      document.documentElement.classList.add('js-reveal');
      {%- endif %}
    </script>
    {{ content_for_header }}
  </head>

  <body>
    <a class="skip-link visually-hidden" href="#MainContent">{{ 'accessibility.skip_to_content' | t }}</a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% render 'whatsapp' %}
    {% section 'cart-drawer' %}
    <div class="scrim" data-scrim></div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>

    {%- if request.page_type == 'index' -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "Organization",
          "name": {{ shop.name | json }},
          "url": {{ request.origin | append: routes.root_url | json }}
          {%- if settings.logo -%}, "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }}{%- endif -%}
          {%- if settings.social_instagram != blank or settings.social_facebook != blank -%}
            , "sameAs": [
              {%- liquid
                assign socials = ''
                if settings.social_instagram != blank
                  assign socials = socials | append: settings.social_instagram | append: '|'
                endif
                if settings.social_facebook != blank
                  assign socials = socials | append: settings.social_facebook | append: '|'
                endif
                if settings.social_pinterest != blank
                  assign socials = socials | append: settings.social_pinterest | append: '|'
                endif
                assign social_list = socials | split: '|'
              -%}
              {%- for s in social_list -%}{{ s | json }}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}
            ]
          {%- endif %}
        }
      </script>
    {%- endif -%}

    <script>
      window.theme = {
        routes: {
          root: {{ routes.root_url | json }},
          cartAdd: {{ routes.cart_add_url | append: '.js' | json }},
          cartChange: {{ routes.cart_change_url | append: '.js' | json }},
          cart: {{ routes.cart_url | json }},
          predictiveSearch: {{ routes.predictive_search_url | json }},
          recommendations: {{ routes.product_recommendations_url | json }}
        },
        strings: {
          added: {{ 'cart.added' | t | json }},
          error: {{ 'cart.error' | t | json }},
          pinInvalid: {{ 'products.delivery.invalid' | t | json }},
          pinResult: {{ 'products.delivery.result_html' | t | json }},
          cod: {{ 'products.delivery.cod' | t | json }},
          unavailable: {{ 'products.unavailable' | t | json }},
          soldOut: {{ 'products.sold_out' | t | json }},
          addToCart: {{ 'products.add_to_cart' | t | json }},
          fitAcross: {{ 'products.size_check.across' | t | json }},
          fitSmall: {{ 'products.size_check.fit_small' | t | json }},
          fitMedium: {{ 'products.size_check.fit_medium' | t | json }},
          fitLarge: {{ 'products.size_check.fit_large' | t | json }}
        },
        deliveryDays: {{ settings.delivery_days | json }},
        codAvailable: {{ settings.cod_available | json }},
        locale: {{ request.locale.iso_code | append: '-IN' | json }}
      };
    </script>
    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </body>
</html>
