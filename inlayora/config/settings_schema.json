    "theme_documentation_url": "https://help.shopify.com/manual/online-store/themes",
    "theme_support_url": "https://support.shopify.com/"
  },
  {
    "name": "Colours",
    "settings": [
      { "type": "header", "content": "Page" },
      { "type": "color", "id": "color_background", "label": "Background", "default": "#f3f2ef" },
      { "type": "color", "id": "color_paper", "label": "Light surface", "default": "#fbfbfa" },
      { "type": "color", "id": "color_step", "label": "Soft surface", "default": "#ece9e3" },
      { "type": "color", "id": "color_text", "label": "Text", "default": "#1c1c1c" },
      { "type": "color", "id": "color_muted", "label": "Secondary text", "default": "#4a5259" },
      { "type": "header", "content": "Buttons and accents" },
      { "type": "color", "id": "color_accent", "label": "Accent", "default": "#2c3620" },
      { "type": "color", "id": "color_accent_text", "label": "Text on accent", "default": "#ecebe4" },
      { "type": "header", "content": "Tile colours" },
      { "type": "color", "id": "color_field_1", "label": "Tile 1 (slate)", "default": "#dde3e7" },
      { "type": "color", "id": "color_field_2", "label": "Tile 2 (sage)", "default": "#dfe8e1" },
      { "type": "color", "id": "color_field_3", "label": "Tile 3 (blush)", "default": "#ede5df" }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      { "type": "range", "id": "page_width", "label": "Page width", "min": 1100, "max": 1600, "step": 20, "unit": "px", "default": 1380 },
      { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 24, "step": 1, "unit": "px", "default": 14 },
      { "type": "checkbox", "id": "animations", "label": "Reveal sections on scroll", "default": true }
    ]
  },
  {
    "name": "Cart and delivery",
    "settings": [
      { "type": "number", "id": "free_shipping_threshold", "label": "Free delivery from (₹)", "info": "Shows a progress bar in the cart. Set 0 if delivery is free on every order.", "default": 999 },
      { "type": "range", "id": "dispatch_days", "label": "Dispatch time (working days)", "min": 1, "max": 10, "step": 1, "default": 3 },
      { "type": "range", "id": "delivery_days", "label": "Delivery time incl. dispatch (days)", "min": 2, "max": 21, "step": 1, "default": 7 },
      { "type": "checkbox", "id": "cod_available", "label": "Cash on delivery available", "default": true },
      { "type": "number", "id": "return_days", "label": "Return window (days)", "default": 7 }
    ]
  },
  {
    "name": "Contact",
    "settings": [
      { "type": "text", "id": "whatsapp_number", "label": "WhatsApp number", "info": "International format without +, e.g. 919876543210" },
      { "type": "checkbox", "id": "whatsapp_enabled", "label": "Show floating WhatsApp button", "default": true },
      { "type": "text", "id": "whatsapp_title", "label": "WhatsApp panel title", "default": "Chat with Inlayora" },
      { "type": "text", "id": "whatsapp_subtitle", "label": "WhatsApp panel subtitle", "default": "We reply on WhatsApp" },
      { "type": "text", "id": "whatsapp_topic_1", "label": "Topic 1", "default": "Diwali offers" },
      { "type": "text", "id": "whatsapp_topic_2", "label": "Topic 2", "default": "Order & delivery help" },
      { "type": "text", "id": "whatsapp_topic_3", "label": "Topic 3", "default": "Something else" },
      { "type": "text", "id": "contact_email", "label": "Contact email", "default": "inlayoraindia@gmail.com" },
      { "type": "url", "id": "social_instagram", "label": "Instagram" },
      { "type": "url", "id": "social_facebook", "label": "Facebook" },
      { "type": "url", "id": "social_pinterest", "label": "Pinterest" }
    ]
  },
  {
    "name": "Brand",
    "settings": [
      { "type": "image_picker", "id": "logo", "label": "Logo", "info": "Leave empty to show the store name as a wordmark." },
      { "type": "range", "id": "logo_width", "label": "Logo width", "min": 60, "max": 240, "step": 4, "unit": "px", "default": 120 },
      { "type": "image_picker", "id": "favicon", "label": "Favicon" }
    ]
  }
]
