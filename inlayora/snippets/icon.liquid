{% doc %}
  Renders an inline SVG icon from the theme's icon set.

  @param {string} name - Icon name: menu, search, user, bag, plus, close, arrow, arrow-left, truck, check, cash, return, shield, zoom, star, whatsapp, filter
  @param {string} [class] - Extra class for the svg

  @example
  {% render 'icon', name: 'bag' %}
{% enddoc %}

{%- case name -%}
  {%- when 'star' -%}
    <svg class="{{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m12 3.2 2.7 5.6 6.1.8-4.5 4.2 1.1 6.1L12 17l-5.4 2.9 1.1-6.1-4.5-4.2 6.1-.8z"/></svg>
  {%- else -%}
    <svg class="icon {{ class }}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
      {%- case name -%}
        {%- when 'menu' -%}<path d="M4 8h16M4 16h16"/>
        {%- when 'search' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2"/>
        {%- when 'user' -%}<circle cx="12" cy="8.5" r="3.8"/><path d="M4.5 20c1.3-3.6 4.2-5.4 7.5-5.4s6.2 1.8 7.5 5.4"/>
        {%- when 'bag' -%}<path d="M5.5 8.5h13l-1 11.5h-11z"/><path d="M9 8.5V7a3 3 0 0 1 6 0v1.5"/>
        {%- when 'plus' -%}<path d="M12 5v14M5 12h14"/>
        {%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
        {%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
        {%- when 'arrow-left' -%}<path d="M19 12H5M11 6l-6 6 6 6"/>
        {%- when 'truck' -%}<path d="M3 6.5h11v9H3zM14 9.5h4l3 3v3h-7"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="17.5" cy="17.5" r="1.8"/>
        {%- when 'check' -%}<path d="m5 12.5 4.5 4.5L19 7.5"/>
        {%- when 'cash' -%}<rect x="3" y="6.5" width="18" height="11" rx="2"/><circle cx="12" cy="12" r="2.5"/>
        {%- when 'return' -%}<path d="M4 9h11a5 5 0 0 1 0 10H8"/><path d="m8 5-4 4 4 4"/>
        {%- when 'shield' -%}<path d="M12 3.5 5 6v5.5c0 4.3 3 7.6 7 9 4-1.4 7-4.7 7-9V6z"/><path d="m9 12 2.2 2.2L15.5 10"/>
        {%- when 'zoom' -%}<circle cx="11" cy="11" r="6.5"/><path d="m20 20-4.2-4.2M11 8.5v5M8.5 11h5"/>
        {%- when 'filter' -%}<path d="M4 7h10M18 7h2M4 17h4M12 17h8"/><circle cx="16" cy="7" r="2"/><circle cx="10" cy="17" r="2"/>
        {%- when 'whatsapp' -%}<path d="M4.5 19.5 5.6 16A8 8 0 1 1 8.4 18.6z"/><path d="M9.2 9.1c.3 2.3 2.4 4.6 4.9 5.2l1.1-1.1-1.6-1-.9.6c-.8-.4-1.6-1.2-2-2l.6-.9-1-1.6z"/>
      {%- endcase -%}
    </svg>
{%- endcase -%}
