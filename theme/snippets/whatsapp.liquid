{% doc %}
  Floating WhatsApp button that opens a small panel of topics. Each topic opens WhatsApp with a prefilled message.
  On product pages the first topic asks about the current product.

  @example
  {% render 'whatsapp' %}
{% enddoc %}

<style>
  .wa { position: fixed; right: 16px; bottom: calc(16px + env(safe-area-inset-bottom)); z-index: 44; display: grid; justify-items: end; gap: 10px; transition: bottom 320ms var(--ease-drawer), transform 240ms var(--ease-out), opacity 240ms ease; }
  .wa.is-tucked { transform: translateY(24px); opacity: 0; pointer-events: none; }
  body.has-buybar .wa { bottom: calc(92px + env(safe-area-inset-bottom)); }
  .wa__btn { width: 56px; height: 56px; border-radius: 50%; background: #25d366; color: #fff; display: grid; place-items: center; box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.35); transition: transform 160ms var(--ease-out); }
  .wa__btn:active { transform: scale(0.94); }
  .wa__btn .icon { width: 28px; height: 28px; stroke-width: 1.8; }
  .wa__panel { width: min(320px, calc(100vw - 32px)); background: var(--paper); border-radius: var(--r); box-shadow: 0 24px 60px -16px rgba(0, 0, 0, 0.35); overflow: hidden; transform-origin: bottom right; animation: wa-in 220ms var(--ease-out); }
  .wa__panel[hidden] { display: none; }
  @keyframes wa-in { from { opacity: 0; transform: translateY(8px) scale(0.97); } }
  .wa__head { display: flex; align-items: center; gap: 10px; padding: 14px 8px 14px 14px; background: #075e54; color: #fff; }
  .wa__head b { display: block; font-weight: 500; }
  .wa__head span { font-size: var(--s-small); opacity: 0.85; }
  .wa__head > div { flex: 1; min-width: 0; }
  .wa__logo { width: 36px; height: 36px; border-radius: 50%; background: #25d366; display: grid; place-items: center; flex: none; }
  .wa__logo .icon { width: 20px; height: 20px; }
  .wa__close { width: 40px; height: 40px; display: grid; place-items: center; border-radius: 999px; color: #fff; }
  .wa__close .icon { width: 18px; height: 18px; }
  .wa__ask { margin: 14px 14px 8px; font-size: var(--s-small); color: var(--muted); }
  .wa__list { list-style: none; margin: 0; padding: 0 10px 12px; display: grid; gap: 6px; }
  .wa__list a { display: grid; gap: 2px; min-height: 48px; align-content: center; padding: 10px 14px; border-radius: 12px; background: var(--step); font-weight: 500; transition: background-color 160ms ease; }
  .wa__list a:hover { background: var(--f2); }
  .wa__list small { font-weight: 400; font-size: var(--s-small); color: var(--muted); }
  @media (min-width: 1000px) { body.has-buybar .wa { bottom: calc(100px + env(safe-area-inset-bottom)); } }
</style>
{%- liquid
  assign number = settings.whatsapp_number | remove: '+' | remove: ' ' | remove: '-'
  assign base = 'https://wa.me/' | append: number | append: '?text='
  assign shop_name = shop.name
-%}
{%- if settings.whatsapp_enabled and number != blank -%}
  <div class="wa" data-wa>
    <div class="wa__panel" id="WhatsAppPanel" role="dialog" aria-label="{{ 'whatsapp.title' | t }}" hidden>
      <div class="wa__head">
        <span class="wa__logo" aria-hidden="true">{% render 'icon', name: 'whatsapp' %}</span>
        <div>
          <b>{{ settings.whatsapp_title | default: shop_name }}</b>
          <span>{{ settings.whatsapp_subtitle }}</span>
        </div>
        <button type="button" class="wa__close" data-wa-close aria-label="{{ 'header.close' | t }}">{% render 'icon', name: 'close' %}</button>
      </div>
      <p class="wa__ask">{{ 'whatsapp.ask' | t }}</p>
      <ul class="wa__list" role="list">
        {%- if product -%}
          {%- capture msg -%}{{ 'whatsapp.msg_prefix' | t }} {{ product.title }}: {{ shop.url }}{{ product.url }}{%- endcapture -%}
          <li><a href="{{ base }}{{ msg | replace: '&amp;', '&' | url_encode }}" target="_blank" rel="noopener">{{ 'whatsapp.topic_product' | t }}<small>{{ product.title | truncate: 40 }}</small></a></li>
        {%- endif -%}
        {%- for i in (1..3) -%}
          {%- liquid
            case i
              when 1
                assign label = settings.whatsapp_topic_1
              when 2
                assign label = settings.whatsapp_topic_2
              else
                assign label = settings.whatsapp_topic_3
            endcase
          -%}
          {%- if label != blank -%}
            {%- capture msg -%}{{ 'whatsapp.msg_prefix' | t }} {{ label }}{%- endcapture -%}
            <li><a href="{{ base }}{{ msg | replace: '&amp;', '&' | url_encode }}" target="_blank" rel="noopener">{{ label }}</a></li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    </div>
    <button type="button" class="wa__btn" data-wa-toggle aria-expanded="false" aria-controls="WhatsAppPanel" aria-label="{{ 'whatsapp.open' | t }}">
      {% render 'icon', name: 'whatsapp' %}
    </button>
  </div>
{%- endif -%}

