<style>
  .hl { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  @media (min-width: 900px) { .hl { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12px; } }
  .hl__card { border-radius: var(--r); overflow: hidden; display: grid; grid-template-rows: auto 1fr; }
  .hl__card img { aspect-ratio: 4 / 3; object-fit: cover; width: 100%; }
  .hl__card div { padding: 12px 12px 14px; }
  .hl__card b { display: block; font-weight: 500; font-size: 1rem; line-height: 1.3; }
  .hl__card p { margin: 4px 0 0; font-size: var(--s-small); color: var(--muted); }
  @media (min-width: 900px) { .hl__card div { padding: 16px 18px 20px; } .hl__card b { font-size: 1.125rem; } }
</style>
<div class="frame section pxs">
  <div class="sec-head rv"><h2 class="h-sec">{{ section.settings.heading }}</h2></div>
  <div class="hl">
    {%- for block in section.blocks -%}
      {%- liquid
        assign media_index = forloop.index
        assign img = block.settings.image | default: product.media[media_index].preview_image
      -%}
      <article class="hl__card {{ block.settings.tone }} rv" style="--i: {{ forloop.index0 | modulo: 4 }}" {{ block.shopify_attributes }}>
        {%- if img -%}
          {{ img | image_url: width: 700, height: 525, crop: 'center' | image_tag: widths: '350, 500, 700', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: '' }}
        {%- endif -%}
        <div><b>{{ block.settings.title }}</b><p>{{ block.settings.text }}</p></div>
      </article>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Product highlights",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Why it earns a place on your table" }
  ],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use one of the product's own photos." },
        { "type": "text", "id": "title", "label": "Title", "default": "Wipes clean" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Describe this benefit." },
        { "type": "select", "id": "tone", "label": "Colour", "options": [{ "value": "f2", "label": "Sage" }, { "value": "f3", "label": "Blush" }, { "value": "f1", "label": "Slate" }, { "value": "f0", "label": "Stone" }], "default": "f2" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Product highlights", "blocks": [{ "type": "highlight" }] }],
  "enabled_on": { "templates": ["product"] }
}
{% endschema %}
