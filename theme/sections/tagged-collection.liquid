<style>
  .tags { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px 8px; }
  @media (min-width: 900px) { .tags { grid-template-columns: repeat(4, 1fr); gap: 28px 12px; } }
  .tagged { display: block; border-radius: var(--r); overflow: hidden; }
  .tagged__pic { aspect-ratio: 4 / 5; overflow: hidden; background: var(--step); }
  .tagged__pic img { width: 100%; height: 100%; object-fit: cover; transition: transform 900ms var(--ease-out); }
  @media (hover: hover) and (pointer: fine) { .tagged:hover .tagged__pic img { transform: scale(1.04); } }
  .tagged__strip { padding: 12px 14px 14px; font-size: var(--s-small); display: grid; gap: 4px; }
  .tagged__strip b { font-weight: 500; font-size: 1rem; line-height: 1.3; }
  .tagged__strip > span { display: flex; justify-content: space-between; gap: 8px; }
  .tagged__strip .price { color: inherit; }
  .tagged__strip .price s { color: inherit; opacity: 0.7; }
  @media (max-width: 599px) { .tagged__strip > span { flex-direction: column; gap: 0; } }
</style>
{%- assign coll = section.settings.collection -%}
<div class="frame section">
  <div class="sec-head rv">
    <h2 class="h-sec">{{ section.settings.heading }}</h2>
    {%- if coll -%}<a class="btn btn--paper" href="{{ coll.url }}">{{ 'general.view_all' | t }}</a>{%- endif -%}
  </div>
  <div class="tags">
    {%- if coll and coll.products_count > 0 -%}
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- assign tone = forloop.index0 | modulo: 4 -%}
        {%- assign img = product.featured_media.preview_image -%}
        <a class="tagged rv" style="--i: {{ forloop.index0 | modulo: 4 }}" href="{{ product.url }}">
          <div class="tagged__pic">
            {%- if img -%}{{ img | image_url: width: 800, height: 1000, crop: 'center' | image_tag: widths: '300, 450, 600, 800', sizes: '(min-width: 900px) 25vw, 50vw', loading: 'lazy', alt: product.title }}{%- endif -%}
          </div>
          <div class="tagged__strip {% case tone %}{% when 0 %}f2{% when 1 %}f3{% when 2 %}f1{% else %}f4{% endcase %}">
            <b>{{ product.title }}</b>
            <span><span>{{ product.metafields.custom.short_fact.value | default: product.type }}</span>{% render 'price', target: product, show_from: true %}</span>
          </div>
        </a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "New arrivals strip",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "New this month" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "label": "Products", "min": 4, "max": 12, "step": 4, "default": 8 }
  ],
  "presets": [{ "name": "New arrivals strip" }]
}
{% endschema %}
