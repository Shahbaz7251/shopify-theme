<style>
  .contact { display: grid; gap: 32px; }
  @media (min-width: 900px) { .contact { grid-template-columns: 5fr 7fr; gap: 56px; align-items: start; } }
  .contact__ways { list-style: none; padding: 0; margin: 24px 0 0; display: grid; gap: 8px; }
  .contact__ways li { border-radius: 12px; padding: 14px 18px; display: grid; gap: 2px; font-weight: 500; }
  .contact__form { border-radius: var(--r); padding: 22px; display: grid; gap: 14px; }
  @media (min-width: 600px) { .contact__form { grid-template-columns: 1fr 1fr; } .contact__full, .contact__form > p, .contact__form > [role="alert"] { grid-column: 1 / -1; } }
</style>
<div class="frame section contact">
  <div class="rv">
    <h2 class="h-sec">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="body rte">{{ section.settings.text }}</div>{%- endif -%}
    <ul class="contact__ways">
      {%- if settings.whatsapp_number != blank -%}<li class="f2"><span class="small">WhatsApp</span><a href="https://wa.me/{{ settings.whatsapp_number }}" target="_blank" rel="noopener">+{{ settings.whatsapp_number }}</a></li>{%- endif -%}
      {%- if settings.contact_email != blank -%}<li class="f3"><span class="small">{{ 'contact.email' | t }}</span><a href="mailto:{{ settings.contact_email }}">{{ settings.contact_email }}</a></li>{%- endif -%}
      {%- if section.settings.hours != blank -%}<li class="f1"><span class="small">{{ 'contact.hours' | t }}</span><span>{{ section.settings.hours }}</span></li>{%- endif -%}
    </ul>
  </div>

  {%- form 'contact', class: 'contact__form f0' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-success" role="status">{{ 'contact.success' | t }}</p>
    {%- endif -%}
    {%- if form.errors -%}
      <div class="form-error" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div>
      <label class="label" for="ContactName">{{ 'contact.name' | t }}</label>
      <input class="field" id="ContactName" type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}">
    </div>
    <div>
      <label class="label" for="ContactEmail">{{ 'contact.email' | t }} <span aria-hidden="true">*</span></label>
      <input class="field" id="ContactEmail" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}">
    </div>
    <div>
      <label class="label" for="ContactPhone">{{ 'contact.phone' | t }}</label>
      <input class="field" id="ContactPhone" type="tel" name="contact[phone]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div>
      <label class="label" for="ContactOrder">{{ 'contact.order' | t }}</label>
      <input class="field" id="ContactOrder" type="text" name="contact[order_number]">
    </div>
    <div class="contact__full">
      <label class="label" for="ContactBody">{{ 'contact.message' | t }} <span aria-hidden="true">*</span></label>
      <textarea class="field" id="ContactBody" name="contact[body]" required>{{ form.body }}</textarea>
    </div>
    <button class="btn btn--accent contact__full" type="submit">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Talk to us" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Questions about sizes, custom orders or an existing order? We reply within one working day.</p>" },
    { "type": "text", "id": "hours", "label": "Address" }
  ],
  "presets": [{ "name": "Contact form" }]
}
{% endschema %}
