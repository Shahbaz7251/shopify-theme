<style>
  .hlite { padding-top: 24px; }
  .hlite__box { border-radius: calc(var(--r) + 6px); padding: 20px 14px 22px; }
  @media (min-width: 900px) { .hlite__box { padding: 32px; } }
  .hlite__head { display: flex; justify-content: space-between; align-items: flex-end; gap: 16px; margin-bottom: 20px; }
  .hlite__head .body { margin-top: 8px; }
  .hlite__badge { display: inline-block; margin-bottom: 10px; padding: 5px 11px; border-radius: 999px; background: var(--paper); font-size: var(--s-small); font-weight: 500; }
  .hlite .card__tile { background: var(--paper); }
  @media (max-width: 599px) { .hlite__head .btn { min-height: 42px; padding: 0 16px; } }
</style>
{%- liquid
  assign source = section.settings.collection
  assign picks = 0
  assign show = false
  if source and collection and source.handle != collection.handle and current_page == 1
    for product in source.products limit: 50
      assign handles = product.collections | map: 'handle'
      if handles contains collection.handle
        assign picks = picks | plus: 1
      endif
    endfor
    if picks > 0
      assign show = true
    endif
  endif
-%}
{%- if show -%}
  <div class="frame hlite">
    <div class="hlite__box {{ section.settings.tone }}">
      <div class="hlite__head">
        <div>
          {%- if section.settings.badge != blank -%}<span class="hlite__badge">{{ section.settings.badge }}</span>{%- endif -%}
          <h2 class="h-sec">{{ section.settings.heading }}</h2>
          {%- if section.settings.text != blank -%}<p class="body">{{ section.settings.text }}</p>{%- endif -%}
        </div>
        <a class="btn btn--paper" href="{{ source.url }}">{{ 'general.view_all' | t }}</a>
      </div>
      <div class="spec-grid">
        {%- assign shown = 0 -%}
        {%- for product in source.products limit: 50 -%}
          {%- assign handles = product.collections | map: 'handle' -%}
          {%- if handles contains collection.handle and shown < section.settings.limit -%}
            {%- if shown < 2 -%}
              {% render 'product-card', product: product, index: shown, eager: true %}
            {%- else -%}
              {% render 'product-card', product: product, index: shown %}
            {%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Collection highlight",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Highlight collection", "info": "Products from this collection that also belong to the page's collection appear first, e.g. a seasonal Special." },
    { "type": "text", "id": "badge", "label": "Label", "default": "New in" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured" },
    { "type": "text", "id": "text", "label": "Text", "default": "A hand-picked selection." },
    { "type": "range", "id": "limit", "label": "Products", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "select", "id": "tone", "label": "Background", "options": [{ "value": "f3", "label": "Blush" }, { "value": "f2", "label": "Sage" }, { "value": "f1", "label": "Slate" }, { "value": "f0", "label": "Stone" }], "default": "f3" }
  ],
  "presets": [{ "name": "Collection highlight" }],
  "enabled_on": { "templates": ["collection"] }
}
{% endschema %}
